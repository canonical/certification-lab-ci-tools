#!/usr/bin/env bash

# Comment out apt sources whose archive no longer exists (on the device).
#
# The focal OEM images ship "deb http://archive.canonical.com/ubuntu focal
# partner". That archive is retired, so apt-get update fails on it and the job
# stops before any test runs. The line is commented out here, per reprovision.
#
# RETIRED_HOSTS can be overridden with a space separated list of hosts.

RETIRED_HOSTS=${RETIRED_HOSTS:-"archive.canonical.com"}

for host in $RETIRED_HOSTS; do
    files=$(_run "grep -lE '^[^#].*://${host}/' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null")
    if [ -z "$files" ]; then
        log "no $host source on ${DEVICE_IP}"
        continue
    fi
    for file in $files; do
        log "disabling $host in $file on ${DEVICE_IP}"
        _run "sudo sed -i -E 's|^([^#].*://${host}/.*)\$|# disabled: ${host} is retired upstream: \1|' $file"
    done
done
